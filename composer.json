{
    "name": "mifesta/dotenv-editor",
    "description": "Edit Laravel .env files from PHP or Artisan",
    "keywords": [
        "laravel",
        "dotenv",
        "dotenv-editor",
        "env"
    ],
    "homepage": "https://github.com/Mifesta/laravel-dotenv-editor",
    "license": "MIT",
    "authors": [
        {
            "name": "Sergei Gruzdov",
            "email": "cardee@mifesta.com",
            "homepage": "https://github.com/cardee2000",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/config": "^11.0",
        "illuminate/console": "^11.0",
        "illuminate/container": "^11.0",
        "illuminate/support": "^11.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Mifesta\\DotenvEditor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mifesta\\DotenvEditor\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "aliases": {
                "DotenvEditor": "Mifesta\\DotenvEditor\\Facades\\DotenvEditor"
            },
            "providers": [
                "Mifesta\\DotenvEditor\\DotenvEditorServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable"
}
